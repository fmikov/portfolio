---
const skillGroups = [
  {
    category: 'Languages',
    skills: ['C++', 'C#', 'C', 'Python', 'Java', 'VHDL', 'JavaScript', 'SQL', 'GLSL', 'HTML', 'CSS'],
  },
  {
    category: 'Tools & Libraries',
    skills: ['Git', 'OpenGL', 'PyTorch', 'OR-Tools', 'FPGA', 'Dr.Jit'],
  },
  {
    category: 'Engines & Software',
    skills: ['Unreal Engine', 'Unity', 'Godot', 'Blender'],
  },
  {
    category: 'Domains',
    skills: ['Machine Learning', 'Computer Graphics'],
  },
];
---

<section id="skills">
  <h2 class="section-title">Skills</h2>
  <dl class="skills">
    {skillGroups.map((group) => (
      <div class="skills__row">
        <dt>{group.category}</dt>
        <dd>{group.skills.join(', ')}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .skills__row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
  }

  .skills dt {
    color: var(--text-muted);
  }

  .skills dd {
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .skills__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
