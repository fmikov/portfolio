---
---

<section id="events" class="fade-in">
  <h2 class="section-title">Events</h2>
  <div class="events__grid">
    <div class="card event">
      <div class="event__badge">1st Place</div>
      <h3 class="event__title">HackZurich 2023</h3>
      <p class="event__subtitle">Logitech Challenge</p>
      <p class="event__desc">Built a link between devices and AI — a productivity-enhancing extension for Logitech products.</p>
    </div>
    <div class="card event">
      <div class="event__badge">1st Place</div>
      <h3 class="event__title">Bloomberg BPuzzled 2025</h3>
      <p class="event__subtitle">EPFL</p>
      <p class="event__desc">Won 1st place at the competitive puzzle-solving event held at EPFL.</p>
    </div>
  </div>
</section>

<style>
  .events__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .event {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .event__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--accent-glow);
    border: 1px solid var(--accent-dim);
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .event__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .event__subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .event__desc {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
