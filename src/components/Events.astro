---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const events = [
  {
    title: 'Epic AI MegaJam 2026',
    result: 'Jam entry',
    subtitle: 'The Last Shots (Unreal Engine 5)',
    desc: 'A nature photography game made in four days for the theme "Director\'s Cut": four scenes, one per light, Rodin-generated wildlife and an old cinematographer teaching you to see.',
    link: `${base}/projects/events/the-last-shots/`,
    linkText: 'Read the dev log',
  },
  {
    title: 'HackZurich 2023',
    result: '1st Place',
    subtitle: 'Logitech Challenge',
    desc: 'Built a link between devices and AI — a productivity-enhancing extension for Logitech products.',
  },
  {
    title: 'Bloomberg BPuzzled 2025',
    result: '1st Place',
    subtitle: 'EPFL',
    desc: 'Won 1st place at the competitive puzzle-solving event held at EPFL.',
  },
];
---

<section id="events">
  <h2 class="section-title">Events</h2>
  <ul class="list">
    {events.map((e) => (
      <li>
        <div class="row__head">
          <h3 class="row__title">{e.title}</h3>
          <span class="row__date">{e.result}</span>
        </div>
        <p class="row__sub">{e.subtitle}</p>
        <p class="row__body">{e.desc}</p>
        {e.link && <p class="row__body"><a href={e.link}>{e.linkText} →</a></p>}
      </li>
    ))}
  </ul>
</section>
