<section class="hero">
  <p class="hero__greeting">Hi, I'm</p>
  <h1 class="hero__name">Filip Mikovíny</h1>
  <p class="hero__title">MSc Computer Science @ EPFL</p>
  <p class="hero__tagline">Graphics, game development & systems programming</p>
  <nav class="hero__nav">
    <a href="#about">About</a>
    <a href="#projects">Projects</a>
    <a href="#experience">Experience</a>
