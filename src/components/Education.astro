---
const degrees = [
  {
    title: 'MSc Thesis (Exchange)',
    date: '2026 – present',
    school: 'Norwegian University of Science and Technology (NTNU), Visual Computing Lab — Trondheim, Norway',
    thesis: {
      title: 'Hardware-Aware AI Surrogate Modeling: Unlocking Asynchronous Compute and FP8 Inference for Real-Time CFD',
      href: '/portfolio/projects/masters-thesis',
    },
  },
  {
    title: 'MSc in Computer Science',
    date: '2023 – present',
    school: 'École Polytechnique Fédérale de Lausanne (EPFL)',
    courses: 'Advanced Computer Graphics, Computer Vision, Geometric Computing, Machine Learning',
  },
  {
    title: 'BSc in Computer Science',
    date: '2020 – 2023',
    school: 'École Polytechnique Fédérale de Lausanne (EPFL)',
    courses: 'Introduction to Computer Graphics, Parallelism and Concurrency, Algorithms and Data Structures',
  },
];
---

<section id="education">
  <h2 class="section-title">Education</h2>
  <ul class="list">
    {degrees.map((d) => (
      <li>
        <div class="row__head">
          <h3 class="row__title">{d.title}</h3>
          <span class="row__date">{d.date}</span>
        </div>
        <p class="row__sub">{d.school}</p>
        {d.thesis && (
          <p class="row__body">
            Thesis: <a href={d.thesis.href}><em>{d.thesis.title}</em></a>
          </p>
        )}
        {d.courses && <p class="row__body">Relevant courses: {d.courses}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .row__body a {
    color: inherit;
    text-decoration-color: var(--text-muted);
  }

  .row__body a:hover {
    text-decoration-color: currentColor;
  }
</style>
