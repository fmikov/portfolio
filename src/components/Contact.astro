<section id="contact" class="fade-in">
  <h2 class="section-title">Contact</h2>
  <p class="contact__intro">Feel free to reach out — I'm always open to interesting projects and opportunities.</p>
  <div class="contact__list">
    <a href="mailto:filip.mikoviny1@gmail.com" class="contact__item">
      <span class="contact__label">Email</span>
      <span>filip.mikoviny1@gmail.com</span>
    </a>
    <div class="contact__item">
      <span class="contact__label">Phone</span>
      <span>+41 77 278 53 46</span>
    </div>
    <div class="contact__item">
      <span class="contact__label">Location</span>
      <span>Lausanne, Switzerland</span>
    </div>
  </div>
</section>

<footer class="footer">
  <p>&copy; 2025 Filip Mikovíny</p>
</footer>

<style>
  .contact__intro {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .contact__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact__item {
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .contact__label {
    color: var(--text-muted);
    min-width: 80px;
    font-weight: 500;
  }

  .footer {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
    max-width: var(--max-width);
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .contact__item {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
