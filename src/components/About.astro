<section id="about" class="fade-in">
  <h2 class="section-title">About</h2>
  <div class="about__content">
    <p>
      I'm a Computer Science master's student at EPFL in Lausanne, Switzerland, passionate about
      computer graphics, game development, and systems programming. I enjoy building things that are
      both technically challenging and visually compelling — from physically based renderers to game
      prototypes with custom shaders.
    </p>
    <div class="about__details">
      <div class="about__detail">
        <span class="about__label">Location</span>
        <span>Lausanne, Switzerland</span>
      </div>
      <div class="about__detail">
        <span class="about__label">Languages</span>
        <span>English (C1), French (C1), Slovak (Native)</span>
      </div>
      <div class="about__detail">
        <span class="about__label">Interests</span>
        <span>Game development, 3D modelling, piano, climbing, skiing</span>
      </div>
    </div>
  </div>
</section>

<style>
  .about__content {
    max-width: 680px;
  }

  .about__content p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .about__details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about__detail {
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .about__label {
    color: var(--text-muted);
    min-width: 100px;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .about__detail {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
