---
const details = [
  { label: 'Location', value: 'Trondheim, Norway · Lausanne, Switzerland' },
  { label: 'Languages', value: 'English (C1), French (C1), Slovak (Native)' },
  { label: 'Interests', value: 'Game development, 3D modelling, piano, climbing, skiing' },
];
---

<section id="about">
  <h2 class="section-title">About</h2>
  <div>
    <p class="about__text">
      I'm a Computer Science master's student at EPFL in Lausanne, Switzerland, passionate about
      machine learning, computer graphics, and game development. I enjoy building things that are
      both technically challenging and visually compelling — from physically based renderers to game
      prototypes with custom shaders. I'm currently writing my master's thesis on exchange at NTNU in
      Trondheim, Norway.
    </p>
    <dl class="kv">
      {details.map((d) => (
        <div class="kv__row">
          <dt>{d.label}</dt>
          <dd>{d.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about__text {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .kv {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
  }

  .kv__row {
    display: flex;
    gap: 1rem;
  }

  .kv dt {
    color: var(--text-muted);
    min-width: 6rem;
  }

  @media (max-width: 640px) {
    .kv__row {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
