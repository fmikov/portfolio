---
const jobs = [
  {
    role: 'Graphics Engineering Intern',
    company: 'Immensive',
    date: 'Jun – Aug 2026',
    details: [
      'Designing and implementing a minimal Vulkan rendering prototype in C# using Silk.NET',
      'Progressively migrating the existing OpenGL rendering backend to Vulkan for finer GPU control, better performance, and stronger multi-threading support',
    ],
  },
  {
    role: '3D Software Engineering Intern',
    company: 'Swiss Motion Technologies SA',
    date: '2025 – 2026',
    details: [
      'Developed a prototype of the core 3D software using Godot with real-time vertex shader previews',
      'Collaborated closely with a 3-person engineering team in a fast-paced Agile startup environment',
      'Developed a constraint-based scheduling system to automate worker shift planning and resource allocation for production',
    ],
  },
];
---

<section id="experience">
  <h2 class="section-title">Experience</h2>
  <ul class="list">
    {jobs.map((job) => (
      <li>
        <div class="row__head">
          <h3 class="row__title">{job.role}</h3>
          <span class="row__date">{job.date}</span>
        </div>
        <p class="row__sub">{job.company}</p>
        <ul class="details">
          {job.details.map((d) => <li>{d}</li>)}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .details {
    list-style: none;
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .details li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .details li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--text-muted);
  }
</style>
