---
import { projects } from '../data/projects';

function getLink(project: (typeof projects)[number]) {
  if (project.slug) return `/portfolio/projects/${project.slug}`;
  if (project.externalUrl) return project.externalUrl;
  return null;
}
---

<section id="projects">
  <h2 class="section-title">Projects</h2>
  <ul class="list">
    {projects.map((project) => {
      const link = getLink(project);
      const isExternal = !project.slug && !!project.externalUrl;
      return (
        <li>
          <div class="row__head">
            <h3 class="row__title">
              {link ? (
                <a
                  href={link}
                  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {project.title}
                  <span class="arrow" aria-hidden="true">{isExternal ? '↗' : '→'}</span>
                </a>
              ) : (
                project.title
              )}
            </h3>
            <span class="row__date">{project.year}</span>
          </div>
          <p class="row__body">{project.description}</p>
          <p class="meta">{project.tags.join(' · ')}</p>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .row__title a {
    text-decoration-color: var(--text-muted);
  }

  .row__title a:hover {
    text-decoration-color: currentColor;
  }

  .arrow {
    display: inline-block;
    margin-left: 0.3rem;
    color: var(--text-muted);
    transition: transform 0.15s, color 0.15s;
  }

  .row__title a:hover .arrow {
    color: var(--text);
    transform: translateX(2px);
  }
</style>
